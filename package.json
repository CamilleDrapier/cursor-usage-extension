{
  "name": "cursor-usage-extension",
  "version": "0.0.4",
  "description": "Browser extension to visualize Cursor usage against ideal pacing",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --outfile=dist/content.js --format=iife --target=es2022 && npm run copy-assets",
    "copy-assets": "mkdir -p dist && cp manifest.json dist/ && cp -r icons dist/ 2>/dev/null || true",
    "watch": "npm run copy-assets && esbuild src/main.ts --bundle --outfile=dist/content.js --format=iife --target=es2022 --watch",
    "clean": "rm -rf dist",
    "generate-icons": "node scripts/generate-icons.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "package:chrome": "npm run build && cd dist && zip -r ../cursor-usage-chrome.zip .",
    "package:firefox": "npm run build && cd dist && zip -r ../cursor-usage-firefox.zip ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^28.0.0",
    "esbuild": "^0.27.3",
    "eslint": "^10.0.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "cursor",
    "usage",
    "browser-extension"
  ],
  "license": "MIT"
}
